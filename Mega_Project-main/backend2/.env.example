## Server
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*

## MongoDB
MONGODB_URI=

## JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

## Cloudinary (image/document storage, and chat voice messages) - NOT used
## for voice-profile audio anymore, see Backblaze B2 below. Still required
## for worker/employer profile photos, resumes/documents, and chat.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

## Backblaze B2 (voice-profile audio storage only), accessed via B2's
## S3-compatible API. Bucket must be private - Node generates short-lived
## signed URLs on demand rather than storing a permanent public link.
## B2_ENDPOINT format: https://s3.<region>.backblazeb2.com
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=

## Python AI service (../ai-service) - recommendation/matching/ranking,
## voice transcription + profile extraction, and job-text translation all
## live there now. Node never calls Sarvam (or any AI provider) directly.
AI_SERVICE_URL=http://localhost:8000
## Must match ai-service's own AI_SERVICE_API_KEY. Leave empty for local
## development - when unset, ai-service allows requests without a key.
AI_SERVICE_API_KEY=
